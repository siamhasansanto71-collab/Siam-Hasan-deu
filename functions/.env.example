# Optional: Specific Google Drive Folder ID to store backups in
# (Get this from the URL of your Google Drive folder: https://drive.google.com/drive/folders/<FOLDER_ID>)
DRIVE_FOLDER_ID=your_google_drive_folder_id_here

# Option A (Recommended): Google Service Account Key JSON string
# GOOGLE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"siam-deu-pharma",...}'

# Option B: OAuth2 Client Credentials (if uploading to a personal Drive without Service Account)
# DRIVE_CLIENT_ID=your_oauth_client_id
# DRIVE_CLIENT_SECRET=your_oauth_client_secret
# DRIVE_REFRESH_TOKEN=your_oauth_refresh_token
